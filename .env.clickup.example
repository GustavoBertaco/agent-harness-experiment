# Copy this file to .env.clickup and fill in your values.
# .env.clickup is gitignored — never commit the real file.

# ClickUp personal API token (Settings → Apps → API Token)
CLICKUP_API_TOKEN=your_clickup_api_token_here

# ClickUp list ID where tasks are created (agent-harness-experiment → List)
CLICKUP_LIST_ID=your_list_id_here
